# ─────────────────────────────────────────────
# AI Oil Spill Intelligence — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# ─────────────────────────────────────────────

# ── Database Configuration ─────────────────────
# 1. PostgreSQL (Default Production / Docker Mode):
#    Set DATABASE_URL to your PostgreSQL/PostGIS connection string.
#    If PostgreSQL is unavailable, the application fails clearly (no silent fallback).
DATABASE_URL=postgresql+psycopg://oilspill_user:your_password_here@localhost:5432/oilspill_db

# 2. Local SQLite Development Mode:
#    To explicitly run with a local SQLite database, choose ONE of these options:
#    Option A: Set USE_SQLITE=true (automatically anchors to project root: oilspill.db)
# USE_SQLITE=true
#    Option B: Set DATABASE_URL to a sqlite URL. Relative paths (e.g. sqlite:///oilspill.db)
#    are resolved deterministically to the project root, regardless of process launch CWD:
# DATABASE_URL=sqlite:///oilspill.db

# 3. Test Database Isolation:
#    Automated tests use a dedicated temporary SQLite database by default.
#    To run tests against a specific isolated database, set TEST_DATABASE_URL:
# TEST_DATABASE_URL=sqlite:///test_custom.db

# ── Security ──────────────────────────────────
# JWT HMAC-SHA256 secret key (must be at least 32 bytes / 256 bits).
# In production, a secure secret is strictly required; missing, short, or default keys are rejected.
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# ── CORS ──────────────────────────────────────
# Frontend origin for CORS whitelisting
FRONTEND_URL=http://localhost:5173

# ── Database credentials (used by docker-compose) ──
POSTGRES_USER=oilspill_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=oilspill_db
POSTGRES_PORT=5432

# ── Application ───────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

